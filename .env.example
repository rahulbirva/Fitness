# 30 Day Wedding Fit - Environment Configuration
# Note: You can also enter and manage your API keys directly inside the app UI under the Settings tab.
# Storing keys here is optional and useful for local development.

# Google Gemini API Key (e.g. from https://aistudio.google.com/)
EXPO_PUBLIC_GEMINI_API_KEY=

# Anthropic Claude API Key (e.g. from https://console.anthropic.com/)
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# xAI Grok API Key (e.g. from https://console.x.ai/)
EXPO_PUBLIC_GROK_API_KEY=
